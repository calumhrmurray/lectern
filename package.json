{
  "name": "lectern-editor",
  "version": "0.1.0",
  "description": "A visual, Keynote-style editor for reveal.js presentations. The HTML file is the document.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lectern": "cli/index.js"
  },
  "files": [
    "dist",
    "cli",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-reveal.js && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "start": "node cli/index.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.0.0",
    "happy-dom": "^15.0.0",
    "jsdom": "^29.1.1",
    "katex": "^0.18.4",
    "reveal.js": "^5.2.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
